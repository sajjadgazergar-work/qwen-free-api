# Conduit host settings
PORT=8000
CONDUIT_BIND_ADDRESS=127.0.0.1
ADMIN_PASSWORD=change-this-dashboard-password
CONDUIT_DATA_DIR=./data
ENABLE_SEARCH=false

# Optional bootstrap sessions. Dashboard-added Qwen accounts persist separately.
# Accepted: login_aliyunid_ticket, tongyi_sso_ticket, complete Cookie headers,
# or supported Qwen web bearer sessions. Alibaba passwords are never stored.
QWEN_TOKENS=
QWEN_ACCOUNT_COOLDOWN_MS=30000

# Provider URLs are set automatically by the canonical Docker Compose stack.
# For host-side development, copy .env.local.example values into .env.
# For external provider deployments, set explicit HTTP(S) URLs here.
# DEEPSEEK_BASE_URL=http://127.0.0.1:22217
# GEMINI_BASE_URL=http://127.0.0.1:18000

# Conduit's private DeepSeek management password. When empty, Conduit creates
# and persists a random value. Set it only when connecting to an existing
# external DeepSeek service that already uses a known admin password.
DEEPSEEK_ADMIN_PASSWORD=
# Only set when the DeepSeek API itself requires a Bearer key.
DEEPSEEK_UPSTREAM_API_KEY=
DEEPSEEK_TIMEOUT_MS=180000
DEEPSEEK_MODELS=deepseek-default,deepseek-expert,deepseek-vision

# Shared only between Conduit and the bundled Gemini management endpoint.
# Set a strong random value if the provider is exposed beyond the private stack.
GEMINI_MANAGEMENT_KEY=
# Only set when the Gemini API itself requires a Bearer key.
GEMINI_UPSTREAM_API_KEY=
GEMINI_TIMEOUT_MS=300000
GEMINI_MANAGEMENT_TIMEOUT_MS=60000
# Used only if live model discovery is temporarily unavailable.
GEMINI_MODELS=gemini-3-pro,gemini-3-flash
