PORT=8000
ADMIN_PASSWORD=change-me

# Optional bootstrap sessions. Dashboard-added Qwen accounts persist separately.
# Accepted: login_aliyunid_ticket, tongyi_sso_ticket, complete Cookie headers,
# or supported Qwen web bearer sessions. Alibaba passwords are never stored.
QWEN_TOKENS=
QWEN_ACCOUNT_COOLDOWN_MS=30000
CONDUIT_DATA_DIR=./data
ENABLE_SEARCH=false

# DeepSeek runs as an isolated provider service (included under providers/deepseek).
DEEPSEEK_BASE_URL=http://deepseek:22217
# Only set this when the DeepSeek service has API-key auth enabled.
DEEPSEEK_UPSTREAM_API_KEY=
DEEPSEEK_TIMEOUT_MS=180000
DEEPSEEK_MODELS=deepseek-default,deepseek-expert,deepseek-vision

# Gemini runs as an isolated managed provider based on Gemini-FastAPI.
GEMINI_BASE_URL=http://gemini:8000
GEMINI_MANAGEMENT_KEY=replace-with-a-long-random-value
# Only set when Gemini-FastAPI API-key authentication is enabled.
GEMINI_UPSTREAM_API_KEY=
GEMINI_TIMEOUT_MS=300000
# Used only if live model discovery is temporarily unavailable.
GEMINI_MODELS=gemini-3-pro,gemini-3-flash
