# Use this mode when Conduit runs with npm on the host while the managed
# DeepSeek and Gemini providers run in Docker via docker-compose.dev.yml.
PORT=8000
ADMIN_PASSWORD=change-this-dashboard-password
CONDUIT_DATA_DIR=./data
ENABLE_SEARCH=false

DEEPSEEK_BASE_URL=http://127.0.0.1:22217
GEMINI_BASE_URL=http://127.0.0.1:18000

# Must match the value passed to the Gemini container by Docker Compose.
GEMINI_MANAGEMENT_KEY=conduit-local-gemini-key

QWEN_TOKENS=
QWEN_ACCOUNT_COOLDOWN_MS=30000
DEEPSEEK_ADMIN_PASSWORD=
DEEPSEEK_UPSTREAM_API_KEY=
GEMINI_UPSTREAM_API_KEY=
